#!/usr/bin/env sh
# Husky pre-commit hook. Add new checks below; keep each one fast (under ~300ms).

# 1. Block new doc-number collisions in research/.
#    From the 2026-05-18 session that hit 4 collisions in one day.
bash "$(git rev-parse --show-toplevel)/scripts/check-research-doc-collisions.sh" || exit 1

# 2. Block secrets in the staged diff (.claude/rules/secret-hygiene.md, doc 683).
bash "$(git rev-parse --show-toplevel)/scripts/git-secret-scan.sh" || exit 1

# 3. Research index is now CI-OWNED (research-index.yml backfills on merge), so a
#    missing folder-index row NO LONGER blocks a commit - PRs must not hand-edit
#    the shared README (that caused concurrent doc PRs to collide). Advisory only.
bash "$(git rev-parse --show-toplevel)/scripts/check-research-index.sh" || echo "[research-index] note: doc(s) not indexed yet - CI backfills on merge (not blocking)"

# 4. Block third-party PII in the staged diff (.claude/rules/pii-hygiene.md).
#    The rule was written 2026-05-23 and its own line 153 called this hook "a
#    worthwhile follow-up"; it was never built, so for fifteen months the rule was
#    a manual checklist. Measured at 0 false positives across the last 40 commits
#    on main before shipping. Fails closed: a security scan that passes on error
#    is not a scan (silent-failure-guard rule 5).
python3 "$(git rev-parse --show-toplevel)/scripts/git-pii-scan.py" || exit 1

# 5. Block retracted claims in the staged diff (~/zao-vault/claims/retracted.tsv).
#    From 2026-09-08: the "Lil WaveWarZ Takeover at NFT NYC 2025" never happened,
#    a retraction was written up on 09-07 and REPORTED AS APPLIED, and a grep on
#    09-08 found it still live in eight places across two repos including a
#    published card. Nothing had been corrected. The same day also found doc 722f
#    still classifying JANGO UU that way months after CLAUDE.md recorded that
#    Zaal superseded it. (This hook is also why the check reads extensionless
#    files: its first version scanned 0 of them, because "pre-commit" has no
#    suffix - so the file installing the check was invisible to it.)
#    Both defences were prose rules, and a prose rule is an honor system: the
#    retraction report was itself a prose rule about the same claim.
#    Advisory-if-absent by design: the ledger lives in ~/zao-vault, and blocking
#    every commit on a machine that has not cloned the vault would get the hook
#    deleted rather than fixed. Fails CLOSED whenever the tool is actually there.
#    135 ms on this repo, inside this file's stated ~300ms budget.
#    <!-- measured 2026-09-08T19:30Z - zao-measure --verify "zao-claims-check --staged latency in ZAOOS pre-commit" -->
if command -v zao-claims-check >/dev/null 2>&1; then
  zao-claims-check --staged || exit 1
else
  echo "[claims] note: zao-claims-check not on PATH - retracted-claim check skipped"
fi
