# Copy to .env.local and fill in. Never commit real values.

# 32+ random characters. Generate with: openssl rand -hex 32
SESSION_SECRET=

# The domain and URL users sign in on (SIWF checks the signed message against these)
APP_DOMAIN=localhost:3000
APP_URL=http://localhost:3000

# Optimism RPC for the Respect check and SIWF verification
OPTIMISM_RPC_URL=https://mainnet.optimism.io

# Any Farcaster hub / Snapchain HTTP API (keyless). Default used if empty.
FARCASTER_HUB_URL=https://haatz.quilibrium.com

# Supabase project for the directory table (supabase/migrations). Server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
