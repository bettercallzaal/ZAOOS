TELEGRAM_BOT_TOKEN=123456:your-token-from-botfather
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...
ANTHROPIC_API_KEY=sk-ant-...   # optional v1; used for natural-language contact-log parsing
BOT_ADMIN_TELEGRAM_IDS=      # comma-separated Telegram user IDs with full access (e.g. 12345678)

# Discord surface for ZOE (bot/src/zoe/discord.ts).
# Optional. If unset, Discord client is skipped (Telegram-only mode).
# To set up: create a Discord bot in Developer Portal, enable Message Content Intent,
# copy the bot token here. Bot will respond ONLY when pinged/@mentioned or DM'd (never proactive).
DISCORD_BOT_TOKEN=              # Discord bot token
DISCORD_ZAAL_ID=                # Zaal's Discord user ID (optional, for owner-only logic)

# POST button publishes for real (bot/src/zoe/posts/publish.ts, doc 2239 fix 1).
# OFF by default: POST marks the draft approved and resends the text to paste.
# ON: POST calls /api/publish/compose with dryRun:false. Publishing is irreversible;
# Zaal flips this himself, after setting PUBLISH_BOT_TOKEN on the app side.
ZOE_POST_PUBLISH=0                 # set to '1' to publish on POST
ZOE_PUBLISH_BEARER=                # must equal the app's PUBLISH_BOT_TOKEN
ZOE_PUBLISH_URL=https://zaoos.com/api/publish/compose   # optional, this is the default
ZOE_PUBLISH_PLATFORMS=farcaster,x  # optional; any of farcaster,x,bluesky,telegram,discord

# ZABAL Bonfire knowledge-graph bridge (bot/src/zoe/recall.ts).
# Absent => ZOE falls back to manual-relay (asks Zaal to query @zabal_bonfire).
# Present => ZOE mirrors captures/decisions into the bonfire (works today) and
# attempts vector-store recall (live once an admin runs labeling on the bonfire).
BONFIRE_API_KEY=             # revealed via signed message at app.bonfires.ai/dashboard
BONFIRE_ID=                  # the ZABAL bonfire id
BONFIRE_API_URL=https://tnt-v2.api.bonfires.ai   # optional, this is the default

# Grill queue: spool every batch instead of appending to ~/zao-vault/BLACKBOARD.md.
# Set to 1 on a box whose vault checkout nothing pushes (the VPS, measured 2026-10-07).
# The mac drain (zao-grill-queue-drain) reads the spool. Default off.
ZOE_GRILL_QUEUE_SPOOL_ONLY=0

# Durable Orchestrator (bot/src/zoe/orchestrator-tick.ts, Stage 1).
# Runs the one-question-at-a-time loop 24/7 on a VPS cron tick (every 5 min).
# OFF by default so it never double-posts while a Claude Code terminal
# orchestrator is running. Turn ON ONLY when no terminal orchestrator is active.
ZOE_ORCHESTRATOR_ENABLED=false   # set to 'true' to enable VPS cron tick
ZOE_ORCHESTRATOR_DAILY=20        # max questions to post per UTC day (prevents runaway)

# Hermes fix PRs: add this label after opening, so the estate's reviewer picks
# the PR up. The label must exist in the target repo. Unset = no label (default).
ZOE_FIX_PR_LABEL=

# ZOE Telegram Mini App board (bot/src/miniapp.ts).
# When set, /board sends an inline Web App button (opens thezao.xyz/board/mini inside Telegram).
# Absent => /board replies with a plain text link to the full board instead.
BOARD_MINI_URL=https://thezao.xyz/board/mini

# Terminals digest: /terminals in ZOE's DM reads zao-vault origin/main
# notes/orca-terminals-latest.md and sends the short version. Default off.
ZOE_TERMINALS_DIGEST=0
# Optional scheduled digest, a cron expression in UTC (e.g. 0 12 * * * = 8am ET).
# Unset = no scheduled send. Held while the grill is stopped.
ZOE_TERMINALS_DIGEST_CRON=

# /grill walks the seat's Waiting on Zaal items first (bot/src/zoe/terminal-grill.ts),
# one at a time with a button per option; answers go word for word to
# ~/.zao/zoe/terminal-answers.jsonl for the seat to read. Default off.
ZOE_GRILL_TERMINALS=0

# Status sends hold for the morning batch instead of dropping (bot/src/zoe/send-budget.ts).
# OFF by default: a `status` send past the per-day cap is dropped, as it always was.
# ON: it is deferred into send-deferred.jsonl and drained with the morning batch.
# Zaal ruled this 2026-10-06; doc 2239 section 5, fix 2. He flips it himself.
ZOE_STATUS_HOLD=0                  # set to '1' to hold status overflow for the morning
# Name the claude CLI's own failure verdict (bot/src/hermes/claude-cli.ts, doc 2239 fix 3).
# OFF by default: a result of subtype error_max_budget_usd / error_max_turns /
# error_during_execution is logged as "unknown: unclassified claude CLI failure".
# ON: it classifies as budget / max_turns / execution with a hint naming the cap.
ZOE_CLI_RESULT_CLASSIFY=0          # set to '1' to classify by the CLI's result subtype

# Grill: a Stop grill button on every grill message; the pause is stored in
# ~/.zao/zoe/grill-pause.json and checked before every grill send. Default off.
ZOE_GRILL_STOP=0
# Grill: decision options lettered A, B, C, D, recommendation first. Default off.
ZOE_GRILL_ABCD=0
